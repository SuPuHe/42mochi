server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;

    server_name localhost;

    # SSL-конфигурация (должна соответствовать вашему Dockerfile.nginx)
    ssl_certificate /etc/nginx/certs/selfsigned.crt;
    ssl_certificate_key /etc/nginx/certs/selfsigned.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # NGINX может обслуживать статические файлы сам,
    # но для простоты проксируем все, включая /public, на FastAPI
    # FastAPI затем обслуживает /public через StaticFiles.

    location / {
        # Проксируем все запросы на FastAPI (сервис web, порт 8000)
        proxy_pass http://web:8000;

        # Заголовки для правильной работы прокси
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Для WebSocket'ов, если они используются
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Если вы хотите, чтобы NGINX обрабатывал статику сам,
    # раскомментируйте этот блок и удалите StaticFiles из main.py:
    # location /public/ {
    #     alias /app/public/; # Путь внутри контейнера web, куда смонтирована public
    #     expires 30d;
    #     add_header Cache-Control "public, max-age=2592000";
    # }
}
